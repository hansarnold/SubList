{
  "name": "open-sublists",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A simple, open-source subscription tracker built for Cloudflare Workers and D1.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "pnpm db:migrate:local && vite",
    "build": "tsc -b && vite build",
    "preview": "pnpm build && vite preview",
    "typegen": "wrangler types --config wrangler.example.jsonc --strict-vars=false",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.worker.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --config wrangler.example.jsonc --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --config wrangler.local.jsonc --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --config wrangler.local.jsonc --env production --remote",
    "build:preview": "tsc -b && CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=wrangler.local.jsonc CLOUDFLARE_ENV=preview vite build",
    "build:production": "tsc -b && CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=wrangler.local.jsonc CLOUDFLARE_ENV=production vite build",
    "build:production:example": "tsc -b && CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=wrangler.example.jsonc CLOUDFLARE_ENV=production vite build",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "deploy:dry-run:example:production": "pnpm build:production:example && wrangler deploy --dry-run --env production",
    "deploy:dry-run:production": "pnpm build:production && wrangler deploy --dry-run --env production",
    "deploy:preview": "pnpm build:preview && wrangler deploy",
    "deploy:production": "pnpm build:production && wrangler deploy",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.0",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-query": "5.101.4",
    "clsx": "2.1.1",
    "hono": "4.13.3",
    "i18next": "26.4.0",
    "jose": "6.2.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/vitest-plugin": "1.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
