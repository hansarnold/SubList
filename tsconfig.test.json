{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vitest/globals", "@cloudflare/vitest-plugin/types", "./worker-configuration.d.ts"]
  },
  "include": [
    "tests",
    "src/domain",
    "src/shared",
    "src/web",
    "src/worker",
    "src/application",
    "src/infrastructure"
  ]
}
