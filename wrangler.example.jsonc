{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-sublists",
  "main": "./src/worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0,
    },
  },
  "triggers": {
    "crons": [],
  },
  "vars": {
    "ENVIRONMENT": "local",
    "PUBLIC_ORIGIN": "http://localhost:5173",
    "TEAM_DOMAIN": "local.invalid",
    "POLICY_AUD": "local-development",
    "EMAIL_REMINDER_MODE": "disabled",
    "EMAIL_REMINDER_FROM": "reminders@example.invalid",
    "EMAIL_REMINDER_PROVIDER_CONFIG_REVISION": "0",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-sublists-local",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "preview": {
      "name": "open-sublists-preview",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": [],
      },
      "vars": {
        "ENVIRONMENT": "preview",
        "PUBLIC_ORIGIN": "https://preview.example.com",
        "TEAM_DOMAIN": "example.cloudflareaccess.com",
        "POLICY_AUD": "replace-with-preview-access-audience",
        "EMAIL_REMINDER_MODE": "disabled",
        "EMAIL_REMINDER_FROM": "reminders@example.invalid",
        "EMAIL_REMINDER_PROVIDER_CONFIG_REVISION": "0",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "open-sublists-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
    },
    "production": {
      "name": "open-sublists-production",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": ["15 18 * * *", "5 * * * *"],
      },
      "routes": [
        {
          "pattern": "sublist.example.com",
          "custom_domain": true,
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_ORIGIN": "https://sublist.example.com",
        "TEAM_DOMAIN": "example.cloudflareaccess.com",
        "POLICY_AUD": "replace-with-production-access-audience",
        "EMAIL_REMINDER_MODE": "disabled",
        "EMAIL_REMINDER_FROM": "reminders@example.invalid",
        "EMAIL_REMINDER_PROVIDER_CONFIG_REVISION": "0",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "open-sublists-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
